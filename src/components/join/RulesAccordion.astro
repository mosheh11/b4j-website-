---
/**
 * Group rules accordion. The CMS gives rich HTML as <h3>title</h3><p>…</p> pairs;
 * the code owns the presentation, so the pairs are parsed at build time into
 * <details> items. Anything that doesn't fit the pattern falls back to .prose.
 */
interface Props { html?: string | null }
const { html = '' } = Astro.props;

const items: { title: string; body: string }[] = [];
const re = /<h3[^>]*>([\s\S]*?)<\/h3>([\s\S]*?)(?=<h3[^>]*>|$)/gi;
for (const m of (html ?? '').matchAll(re)) {
  const title = m[1].replace(/<[^>]+>/g, '').trim();
  const body = m[2].trim();
  if (title) items.push({ title, body });
}
const pad = (n: number) => String(n).padStart(2, '0');
---
{items.length > 0 ? (
  <div class="rules">
    {items.map((it, i) => (
      <details class="rule" open={i === 0}>
        <summary>
          <span class="num" aria-hidden="true">{pad(i + 1)}</span>
          <span class="title">{it.title}</span>
          <span class="toggle" aria-hidden="true"></span>
        </summary>
        <div class="body" set:html={it.body} />
      </details>
    ))}
  </div>
) : html ? (
  <div class="prose" set:html={html} />
) : null}

<style>
  .rules { display: flex; flex-direction: column; gap: 12px; }
  .rule {
    background: var(--white); border: 1px solid var(--line); border-radius: var(--r-md);
    transition: border-color .2s, box-shadow .2s, background-color .2s;
  }
  .rule:hover { border-color: var(--lilac-line); }
  .rule[open] { border-color: var(--lilac-line); box-shadow: 0 14px 36px rgba(84, 52, 201, 0.08); }
  summary {
    display: flex; align-items: center; gap: 16px; min-height: 64px;
    padding: 14px clamp(18px, 3vw, 28px); cursor: pointer; list-style: none;
    border-radius: var(--r-md);
  }
  summary::-webkit-details-marker { display: none; }
  .num {
    flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%;
    background: var(--sand); color: var(--muted); font-size: 0.875rem; font-weight: 700;
    font-variant-numeric: tabular-nums; transition: background-color .2s, color .2s;
  }
  .rule[open] .num { background: var(--purple); color: var(--white); }
  .title { flex: 1; min-width: 0; font-size: 1.1875rem; font-weight: 700; color: var(--ink); line-height: 1.3; }
  .toggle {
    flex: none; position: relative; width: 36px; height: 36px; border-radius: 50%;
    border: 1.5px solid var(--line); transition: border-color .2s, transform .3s var(--ease), background-color .2s;
  }
  .toggle::before, .toggle::after {
    content: ''; position: absolute; left: 50%; top: 50%; width: 14px; height: 2px;
    background: var(--ink); border-radius: 2px; transform: translate(-50%, -50%);
  }
  .toggle::after { transform: translate(-50%, -50%) rotate(90deg); transition: transform .3s var(--ease); }
  summary:hover .toggle { border-color: var(--ink); }
  .rule[open] .toggle { background: var(--lilac); border-color: var(--lilac); }
  .rule[open] .toggle::after { transform: translate(-50%, -50%) rotate(0deg); }
  .body {
    padding: 0 clamp(18px, 3vw, 28px) 22px;
    padding-inline-start: calc(clamp(18px, 3vw, 28px) + 56px);
    font-size: 1.0625rem; line-height: 1.75; color: var(--slate);
  }
  .body :global(p + p) { margin-top: .75em; }
  @media (max-width: 760px) {
    .body { padding-inline-start: clamp(18px, 3vw, 28px); }
    .title { font-size: 1.0625rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .toggle, .toggle::after { transition: none; }
  }
</style>
