---
/**
 * Updates-feed card. One markup, two looks:
 *  - default: image on top (desktop grid) / thumbnail beside text (phones)
 *  - `.is-lead` (set on the wrapper by the feed): wide feature card
 * The title link is stretched over the whole card, so there is one link per post.
 */
import Icon from '../Icon.astro';
import type { Post, PostCategory } from '../../lib/cms';
import { assetUrl, withBase } from '../../lib/cms';
import { UI, formatDate } from '../../lib/labels';

interface Props {
  post: Post;
  categories: PostCategory[];
  headingLevel?: 'h2' | 'h3';
  /** Eager-load the image (first card above the fold). */
  eager?: boolean;
}
const { post, categories, headingLevel = 'h2', eager = false } = Astro.props;
const H = headingLevel;
const catIndex = categories.findIndex((c) => c.id === post.category);
const cat = categories[catIndex];
const href = withBase(`/updates/${post.slug}/`);
const tones = ['purple', 'green', 'sand'] as const;
const tone = tones[Math.max(catIndex, 0) % tones.length];
---
<article class="fc">
  <div class:list={['fc-media', `tone-${tone}`]}>
    {post.image?.id ? (
      <img
        src={assetUrl(post.image, { width: 1200 })}
        alt={post.image.description ?? ''}
        width="1200" height="800"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
      />
    ) : (
      <div class="fc-ph" aria-hidden="true">
        <svg class="fc-ph-path" viewBox="0 0 400 260" preserveAspectRatio="none">
          <path d="M-10 210 C 80 210, 90 120, 190 130 S 320 60, 410 70" fill="none" stroke="currentColor" stroke-width="10" stroke-linecap="round" stroke-dasharray="2 22" />
        </svg>
        <span class="fc-ph-icon"><Icon name="bike" size={40} stroke={1.6} /></span>
      </div>
    )}
  </div>
  <div class="fc-body">
    {cat && <span class="fc-cat">{cat.name}</span>}
    <H class="fc-title"><a href={href} class="fc-link">{post.title}</a></H>
    {post.excerpt && <p class="fc-excerpt">{post.excerpt}</p>}
    <div class="fc-foot">
      <span class="fc-meta">
        {post.author && <span>{post.author}</span>}
        <time datetime={post.date_published}>{formatDate(post.date_published)}</time>
      </span>
      <span class="fc-more" aria-hidden="true">{UI.readMore} ←</span>
    </div>
  </div>
</article>

<style>
  .fc {
    position: relative; height: 100%;
    display: flex; flex-direction: column;
    background: var(--white); border: 1px solid var(--line); border-radius: var(--r-md);
    overflow: hidden; color: var(--ink);
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }
  .fc:hover { transform: translateY(-3px); box-shadow: var(--shadow-lift); border-color: transparent; }
  .fc:focus-within { box-shadow: var(--shadow-lift); }

  /* Media */
  .fc-media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; flex: none; }
  .fc-media img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .fc:hover .fc-media img { transform: scale(1.04); }
  .tone-purple { background: var(--purple-100); color: var(--purple); }
  .tone-green { background: var(--green-50); color: var(--green); }
  .tone-sand { background: var(--sand); color: #B7A788; }
  .fc-ph { position: absolute; inset: 0; display: grid; place-items: center; }
  .fc-ph-path { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .45; }
  .fc-ph-icon {
    position: relative; width: 84px; height: 84px; border-radius: 50%;
    display: grid; place-items: center; background: var(--white); color: currentColor;
    box-shadow: 0 10px 30px rgba(26, 20, 32, .08);
  }

  /* Body */
  .fc-body { flex: 1; display: flex; flex-direction: column; gap: 10px; padding: 22px 24px 20px; min-width: 0; }
  .fc-cat { font-size: 0.8125rem; font-weight: 700; color: var(--purple); }
  .fc-title { font-size: 1.25rem; line-height: 1.3; letter-spacing: -0.01em; }
  .fc-link { color: inherit; text-decoration: none; }
  .fc-link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; z-index: 1; }
  .fc-link:focus-visible { outline: none; }
  .fc-link:focus-visible::after { outline: 3px solid var(--purple); outline-offset: -3px; border-radius: var(--r-md); }
  .fc:hover .fc-link { color: var(--purple); }
  .fc-excerpt {
    font-size: var(--fs-small); line-height: 1.65; color: var(--muted);
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .fc-foot {
    margin-top: auto; padding-top: 14px; border-top: 1px solid var(--line);
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 6px 16px;
  }
  .fc-meta { display: flex; flex-wrap: wrap; gap: 2px 8px; font-size: 0.8125rem; color: var(--muted); }
  .fc-meta > * + *::before { content: '·'; margin-inline-end: 8px; }
  .fc-more { font-size: var(--fs-small); font-weight: 500; color: var(--purple); white-space: nowrap; }
  .fc-more { display: inline-block; transition: transform .2s var(--ease); }
  .fc:hover .fc-more { transform: translateX(-4px); }

  /* ---------- Lead (feature) card ---------- */
  :global(.is-lead) > .fc .fc-title { font-size: var(--fs-h3); line-height: 1.2; letter-spacing: -0.02em; }
  :global(.is-lead) > .fc .fc-excerpt { font-size: var(--fs-body); -webkit-line-clamp: 4; }
  :global(.is-lead) > .fc .fc-cat {
    align-self: flex-start; background: var(--purple); color: var(--white);
    border-radius: var(--r-pill); padding: 5px 12px; line-height: 1.3;
  }
  @media (min-width: 900px) {
    :global(.is-lead) > .fc { flex-direction: row; border-radius: var(--r-lg); }
    :global(.is-lead) > .fc .fc-media { flex: 0 0 56%; aspect-ratio: auto; min-height: 400px; }
    :global(.is-lead) > .fc .fc-body { padding: clamp(28px, 3.4vw, 48px); justify-content: center; gap: 14px; }
    :global(.is-lead) > .fc .fc-foot { margin-top: 18px; }
    :global(.is-lead) > .fc .fc-link:focus-visible::after { border-radius: var(--r-lg); }
  }

  /* ---------- Phones: compact rows for the rest of the feed ---------- */
  @media (max-width: 599px) {
    :global(:not(.is-lead)) > .fc { flex-direction: row; align-items: stretch; border-radius: var(--r-sm); }
    :global(:not(.is-lead)) > .fc .fc-media { flex: 0 0 104px; aspect-ratio: auto; min-height: 112px; margin: 12px; margin-inline-end: 0; border-radius: var(--r-xs); }
    :global(:not(.is-lead)) > .fc .fc-ph-icon { width: 48px; height: 48px; }
    :global(:not(.is-lead)) > .fc .fc-ph-icon :global(svg) { width: 26px; height: 26px; }
    :global(:not(.is-lead)) > .fc .fc-body { padding-block: 14px; padding-inline: 16px 14px; gap: 6px; }
    :global(:not(.is-lead)) > .fc .fc-title { font-size: 1.0625rem; }
    :global(:not(.is-lead)) > .fc .fc-excerpt { display: none; }
    :global(:not(.is-lead)) > .fc .fc-foot { border-top: 0; padding-top: 4px; }
    :global(:not(.is-lead)) > .fc .fc-meta { flex-direction: column; gap: 0; }
    :global(:not(.is-lead)) > .fc .fc-meta > * + *::before { content: none; }
    :global(:not(.is-lead)) > .fc .fc-more { display: none; }
    :global(:not(.is-lead)) > .fc .fc-link:focus-visible::after { border-radius: var(--r-sm); }
    :global(.is-lead) > .fc .fc-body { padding: 22px 20px 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fc, .fc:hover, .fc:hover .fc-media img, .fc:hover .fc-more { transform: none; }
  }
</style>
