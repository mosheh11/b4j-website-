---
/**
 * Inner-page banner on the stone ground. Title (+ optional purple second line),
 * lead text, optional image on the side, optional actions via the default slot.
 */
import type { CmsImage } from '../lib/cms';
import { assetUrl } from '../lib/cms';

interface Props {
  eyebrow?: string;
  title: string;
  highlight?: string;
  text?: string;
  image?: CmsImage | null;
}
const { eyebrow, title, highlight, text, image } = Astro.props;
---
<section class:list={['page-banner', { 'has-image': !!image }]}>
  <div class="container inner">
    <div class="copy rise">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1 class="h1">{title}{highlight && <><br /><span class="accent">{highlight}</span></>}</h1>
      {text && <p class="lead">{text}</p>}
      {Astro.slots.has('default') && <div class="cluster actions"><slot /></div>}
    </div>
    {image && (
      <figure class="art rise-2">
        <img src={assetUrl(image, { width: 1200 })} alt={image.description ?? ''} width="640" height="440" fetchpriority="high" />
        <span class="dot" aria-hidden="true"></span>
      </figure>
    )}
  </div>
  <slot name="after" />
</section>

<style>
  .inner { display: flex; flex-wrap: wrap; align-items: center; gap: 40px 56px; }
  .copy { flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .copy .lead { margin-top: 0; }
  .actions { margin-top: 12px; }
  .art { flex: 1 1 380px; min-width: 0; margin: 0; position: relative; isolation: isolate; }
  .art img { width: 100%; aspect-ratio: 16 / 11; object-fit: cover; border-radius: var(--r-lg); }
  .dot {
    position: absolute; inset-inline-end: -24px; bottom: -28px; width: 112px; height: 112px; border-radius: 50%;
    background: var(--green); z-index: -1;
  }
  @media (max-width: 760px) {
    .art img { aspect-ratio: 4 / 3; }
    .dot { width: 72px; height: 72px; inset-inline-end: -8px; bottom: -18px; }
  }
</style>
