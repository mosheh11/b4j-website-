---
/** Live countdown to an event start (Jerusalem wall-clock). Renders a static date without JS. */
import { jlmDate } from '../lib/cms';
import { UI } from '../lib/labels';
interface Props { start: string; class?: string }
const { start, class: cls } = Astro.props;
const ts = jlmDate(start).getTime();
---
<div class:list={['countdown', cls]} data-countdown={ts} role="timer" aria-live="off">
  <span class="unit"><b data-d>–</b><small>{UI.countdown.days}</small></span>
  <span class="unit"><b data-h>–</b><small>{UI.countdown.hours}</small></span>
  <span class="unit"><b data-m>–</b><small>{UI.countdown.minutes}</small></span>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((el) => {
    const target = Number(el.dataset.countdown);
    const d = el.querySelector('[data-d]')!, h = el.querySelector('[data-h]')!, m = el.querySelector('[data-m]')!;
    const tick = () => {
      const diff = Math.max(0, target - Date.now());
      d.textContent = String(Math.floor(diff / 864e5));
      h.textContent = String(Math.floor((diff % 864e5) / 36e5)).padStart(2, '0');
      m.textContent = String(Math.floor((diff % 36e5) / 6e4)).padStart(2, '0');
      if (diff === 0) { el.classList.add('is-live'); clearInterval(id); }
    };
    const id = setInterval(tick, 30_000); tick();
  });
</script>

<style>
  .countdown { display: inline-flex; gap: 8px; direction: rtl; }
  .unit {
    display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 64px;
    padding: 10px 12px; border-radius: var(--r-xs); background: var(--sand);
  }
  b { font-size: 1.625rem; font-weight: 700; line-height: 1; color: var(--ink); font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  small { font-size: 0.75rem; color: var(--muted); margin-top: 4px; }
</style>
