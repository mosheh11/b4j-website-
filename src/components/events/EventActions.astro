---
/**
 * Action buttons for an event: join/register, add to calendar, Facebook event.
 * Past events get the gallery link instead. Buttons stack full-width on phones.
 */
import Icon from '../Icon.astro';
import AddToCalendar from '../AddToCalendar.astro';
import type { CmsEvent } from '../../lib/cms';
import { UI } from '../../lib/labels';

interface Props {
  event: CmsEvent;
  size?: 'sm' | 'md' | 'lg';
  /** "dark" = on an ink background */
  tone?: 'light' | 'dark';
  /** Always stack (e.g. narrow sidebars), not only on phones. */
  stacked?: boolean;
}
const { event: e, size = 'md', tone = 'light', stacked = false } = Astro.props;
const sz = size !== 'md' ? `btn-${size}` : '';
/** Paid or limited-capacity events are "registration"; free open rides are "join". */
const needsRegistration = !!e.price || e.capacity != null;
const joinLabel = needsRegistration ? UI.register : UI.joinGroup;
---
<div class:list={['actions', { stacked, dark: tone === 'dark' }]}>
  {e.is_upcoming ? (
    <>
      {e.registration_url && (
        <a href={e.registration_url} target="_blank" rel="noopener" class:list={['btn', tone === 'dark' ? 'btn-white primary-on-dark' : 'btn-primary', sz]}>
          {joinLabel}<Icon name="arrow" size={18} stroke={2.2} />
          <span class="visually-hidden">: {e.title} (נפתח בחלון חדש)</span>
        </a>
      )}
      <AddToCalendar event={e} variant={tone === 'dark' ? 'outline' : 'soft'} size={size} />
      {e.facebook_event_url && (
        <a href={e.facebook_event_url} target="_blank" rel="noopener" class:list={['btn', tone === 'dark' ? 'btn-outline' : 'btn-white', sz]}>
          <Icon name="facebook" size={18} />{UI.facebookEvent}
        </a>
      )}
    </>
  ) : (
    e.gallery_url && (
      <a href={e.gallery_url} target="_blank" rel="noopener" class:list={['btn btn-primary', sz]}>
        {UI.toGallery}<Icon name="arrow" size={18} stroke={2.2} />
      </a>
    )
  )}
</div>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-start; }
  .dark :global(.btn-outline) { --btn-fg: var(--white); border-color: rgba(255, 255, 255, .55); }
  .dark :global(.btn-outline:hover) { --btn-bg: var(--white); --btn-fg: var(--ink); border-color: var(--white); }
  .primary-on-dark { border-color: var(--white); }
  .primary-on-dark:hover { --btn-bg: var(--lilac); }

  .stacked { flex-direction: column; align-items: stretch; }
  .stacked > :global(*), .stacked :global(.atc summary) { width: 100%; }

  @media (max-width: 760px) {
    .actions { flex-direction: column; align-items: stretch; }
    .actions > :global(*), .actions :global(.atc summary) { width: 100%; }
    .actions :global(.atc .menu) { inset-inline: 0; min-width: 0; }
  }
</style>
