---
/** Featured banner for the annual ride: big image, key numbers, actions on an ink ground. */
import Icon from '../Icon.astro';
import Countdown from '../Countdown.astro';
import EventActions from './EventActions.astro';
import type { CmsEvent } from '../../lib/cms';
import { assetUrl, withBase } from '../../lib/cms';
import { EVENT_TYPE, formatDate, formatDay, formatTime } from '../../lib/labels';

interface Props { event: CmsEvent; headingLevel?: 'h2' | 'h3' }
const { event: e, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const href = withBase(`/events/${e.slug}/`);
const facts = [
  { label: 'תאריך', value: formatDate(e.start), sub: `${formatDay(e.start).split(',')[0]} · ${formatTime(e.start)}` },
  e.distance_km && { label: 'מרחק', value: `עד ${e.distance_km} ק״מ`, sub: e.meeting_point },
  e.price && { label: 'דמי השתתפות', value: e.price },
  e.spots_left != null && { label: 'מקומות פנויים', value: e.spots_left.toLocaleString('he-IL'), sub: e.capacity ? `מתוך ${e.capacity.toLocaleString('he-IL')}` : undefined, hot: true },
].filter(Boolean) as Array<{ label: string; value: string; sub?: string; hot?: boolean }>;
---
<article class="annual">
  <figure class="art">
    {e.image && <img src={assetUrl(e.image, { width: 1600 })} alt={e.image.description ?? ''} width="1600" height="900" loading="lazy" />}
  </figure>
  <div class="body">
    <span class="eyebrow">{EVENT_TYPE[e.type]} · ההרשמה פתוחה</span>
    <H class="title"><a href={href}>{e.title}</a></H>
    {e.summary && <p class="summary">{e.summary}</p>}
    <dl class="facts">
      {facts.map((f) => (
        <div class:list={['fact', { hot: f.hot }]}>
          <dt>{f.label}</dt>
          <dd><b>{f.value}</b>{f.sub && <span>{f.sub}</span>}</dd>
        </div>
      ))}
    </dl>
    {e.route && <p class="route"><Icon name="route" size={18} /><span>{e.route}</span></p>}
    <Countdown start={e.start} class="cd" />
    <div class="foot">
      <EventActions event={e} tone="dark" size="lg" />
    </div>
    <a href={href} class="link-arrow more">כל הפרטים על הרכיבה השנתית</a>
  </div>
</article>

<style>
  .annual {
    position: relative; isolation: isolate; border-radius: var(--r-xl); background: var(--ink); color: var(--white);
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
  }
  .art { margin: 0; position: relative; min-height: 420px; border-radius: var(--r-xl) 0 0 var(--r-xl); overflow: hidden; order: 2; }
  .art img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .art::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to left, rgba(26,20,32,.35), transparent 40%); }
  .body { padding: clamp(28px, 4vw, 56px); display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .eyebrow { color: #CFC6F2; }
  .title { color: var(--white); font-size: clamp(2rem, 1.4rem + 2.4vw, 3.25rem); line-height: 1.05; letter-spacing: -0.03em; }
  .title a { color: inherit; text-decoration: none; }
  .title a:hover { color: #CFC6F2; }
  .summary { color: var(--night-text); font-size: var(--fs-lead); line-height: 1.6; max-width: 34em; }

  .facts { margin: 6px 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .fact { background: rgba(255, 255, 255, .07); border: 1px solid rgba(255, 255, 255, .12); border-radius: var(--r-sm); padding: 14px 16px; }
  dt { font-size: 0.8125rem; color: var(--night-muted); font-weight: 500; }
  dd { margin: 4px 0 0; display: flex; flex-direction: column; gap: 2px; }
  dd b { font-size: 1.25rem; line-height: 1.25; color: var(--white); letter-spacing: -0.01em; }
  dd span { font-size: 0.8125rem; color: var(--night-muted); }
  .hot { background: var(--green-700); border-color: transparent; }
  .hot dt, .hot dd span { color: #D5EFE6; }

  .route { display: flex; gap: 10px; align-items: flex-start; color: var(--night-text); font-size: var(--fs-small); }
  .route :global(svg) { flex: none; color: #A996F0; margin-top: 2px; }
  .foot { margin-top: 4px; }
  .annual :global(.cd) { align-self: flex-start; }
  .annual :global(.cd .unit) { background: rgba(255, 255, 255, .08); }
  .annual :global(.cd b) { color: var(--white); }
  .annual :global(.cd small) { color: var(--night-muted); }
  .more { color: #CFC6F2; align-self: flex-start; }
  .more:hover { color: var(--white); }

  @media (max-width: 980px) {
    .annual { grid-template-columns: 1fr; }
    .art { order: 0; min-height: 0; aspect-ratio: 16 / 9; border-radius: var(--r-xl) var(--r-xl) 0 0; }
    .art::after { background: linear-gradient(to top, rgba(26,20,32,.5), transparent 45%); }
  }
  @media (max-width: 760px) {
    .art { aspect-ratio: 4 / 3; border-radius: var(--r-lg) var(--r-lg) 0 0; }
    .annual { border-radius: var(--r-lg); }
    .body { padding: 24px 20px 26px; gap: 16px; }
    .facts { grid-template-columns: 1fr 1fr; }
    .annual :global(.cd) { display: flex; }
    .annual :global(.cd .unit) { flex: 1; }
  }
</style>
