---
/** "לא מפספסים אירוע" — three ways to hear about events: WhatsApp, newsletter, synced calendar. */
import Icon from '../Icon.astro';
import { getGroupsSplit, getSiteSettings, withBase } from '../../lib/cms';
import { UI } from '../../lib/labels';

interface Props { title?: string }
const { title = 'לא מפספסים אירוע' } = Astro.props;
const [{ community }, site] = await Promise.all([getGroupsSplit(), getSiteSettings()]);
const feedPath = withBase('/calendar.ics');
const feedHttps = site.calendar_subscribe_url || new URL(feedPath, Astro.site ?? 'https://bikes4jlm.org').href;
const webcal = feedHttps.replace(/^https?:/, 'webcal:');
const google = `https://calendar.google.com/calendar/render?cid=${encodeURIComponent(webcal)}`;
---
<div class="stay" data-fixed={site.calendar_subscribe_url ? '' : undefined}>
  <div class="head">
    <h2 id="stay-title" class="h2">{title}</h2>
    <p class="lead">בחרו את הדרך שנוחה לכם – ונעדכן על כל רכיבה, סדנה ומפגש.</p>
  </div>
  <ul role="list" class="opts">
    {community && (
      <li class="opt wa">
        <span class="ico"><Icon name="whatsapp" size={26} /></span>
        <h3 class="h">קבוצת הוואטסאפ</h3>
        <p>{community.description ?? community.name}</p>
        <a href={community.invite_url} target="_blank" rel="noopener" class="btn btn-whatsapp btn-block">
          <Icon name="whatsapp" size={20} />{UI.joinWhatsapp}
        </a>
      </li>
    )}
    {site.newsletter_url && (
      <li class="opt nl">
        <span class="ico"><Icon name="mail" size={26} /></span>
        <h3 class="h">ניוזלטר במייל</h3>
        <p>סיכום חודשי של האירועים הקרובים, ישר לתיבה. בלי ספאם.</p>
        <a href={site.newsletter_url} target="_blank" rel="noopener" class="btn btn-primary btn-block">
          <Icon name="mail" size={20} />{UI.newsletter}
        </a>
      </li>
    )}
    <li class="opt cal">
      <span class="ico"><Icon name="calendar" size={26} /></span>
      <h3 class="h">יומן מסונכרן</h3>
      <p>כל האירועים מופיעים ביומן שלכם ומתעדכנים מעצמם.</p>
      <div class="cal-actions">
        <a href={webcal} class="btn btn-white btn-block" data-webcal={feedPath}>
          <Icon name="calendar" size={20} />מנוי ביומן (Apple / Outlook)
        </a>
        <a href={google} target="_blank" rel="noopener" class="btn btn-white btn-block" data-gcal={feedPath}>
          <Icon name="plus" size={20} />הוספה ל־Google Calendar
        </a>
      </div>
      <p class="hint"><a href={feedPath} class="feed" download="bikes4jlm.ics">הורדת קובץ היומן (.ics)</a> · מתאים לכל אפליקציית יומן</p>
    </li>
  </ul>
</div>

<script>
  // Build the feed URLs from the current host so previews / sub-path deploys subscribe to themselves.
  document.querySelectorAll<HTMLAnchorElement>('[data-webcal],[data-gcal]').forEach((a) => {
    if (a.closest('.stay')?.hasAttribute('data-fixed')) return;
    const path = (a.dataset.webcal ?? a.dataset.gcal)!;
    const webcal = new URL(path, location.origin).href.replace(/^https?:/, 'webcal:');
    a.href = a.dataset.webcal ? webcal : `https://calendar.google.com/calendar/render?cid=${encodeURIComponent(webcal)}`;
  });
</script>

<style>
  .stay {
    position: relative; overflow: hidden; isolation: isolate;
    background: var(--lilac); border-radius: var(--r-xl); padding: clamp(32px, 5vw, 64px) clamp(20px, 4.5vw, 56px);
  }
  .stay::before {
    content: ''; position: absolute; inset-inline-end: -120px; top: -140px; width: 380px; height: 380px; border-radius: 50%;
    border: 2px dashed rgba(84, 52, 201, .22); z-index: -1;
  }
  .head { display: flex; flex-direction: column; gap: 10px; margin-bottom: clamp(24px, 3vw, 36px); }
  .head .lead { color: var(--slate); }
  .opts { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .opt {
    background: var(--white); border-radius: var(--r-md); padding: 26px 24px 24px;
    display: flex; flex-direction: column; gap: 10px; box-shadow: 0 10px 30px rgba(84, 52, 201, .08);
  }
  .ico { width: 52px; height: 52px; border-radius: 16px; display: grid; place-items: center; margin-bottom: 6px; }
  .wa .ico { background: var(--green-50); color: var(--green-700); }
  .nl .ico { background: var(--purple-100); color: var(--purple); }
  .cal .ico { background: var(--sand); color: var(--ink); }
  .h { font-size: 1.25rem; letter-spacing: -0.01em; }
  .opt > p { color: var(--muted); font-size: var(--fs-small); line-height: 1.6; }
  .opt > .btn, .cal-actions { margin-top: auto; padding-top: 8px; }
  .cal-actions { display: flex; flex-direction: column; gap: 8px; }
  .cal-actions .btn { min-height: 48px; font-size: 0.9375rem; padding-inline: 18px; white-space: normal; text-align: center; }
  .hint { font-size: 0.8125rem !important; }
  .feed { color: var(--purple); font-weight: 500; }
  @media (max-width: 760px) {
    .stay { border-radius: var(--r-lg); }
    .opt { padding: 22px 18px 20px; }
  }
</style>
