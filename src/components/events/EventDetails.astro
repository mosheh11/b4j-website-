---
/** Icon list of an event's practical details: when, where, route, level, price, spots (or participants for past events). */
import Icon from '../Icon.astro';
import type { CmsEvent } from '../../lib/cms';
import { EVENT_LEVEL, UI, formatDay, formatTime, sameDay, formatDuration } from '../../lib/labels';

/** `brief` = only when + where (for compact cards). */
interface Props { event: CmsEvent; brief?: boolean; class?: string }
const { event: e, brief = false, class: cls } = Astro.props;
const when = sameDay(e.start, e.end)
  ? `${formatDay(e.start)} · ${formatTime(e.start)}–${formatTime(e.end)}`
  : `${formatDay(e.start)} ${formatTime(e.start)} – ${formatDay(e.end)} ${formatTime(e.end)}`;
const duration = formatDuration(e.start, e.end);
const level = [e.level && EVENT_LEVEL[e.level], e.distance_km && `${e.distance_km} ק״מ`].filter(Boolean).join(' · ');
---
<ul role="list" class:list={['details', cls]}>
  <li><Icon name="calendar" size={18} /><span><span class="visually-hidden">מתי: </span>{when}{duration && <span class="soft"> ({duration})</span>}</span></li>
  {e.meeting_point && <li><Icon name="pin" size={18} /><span><span class="visually-hidden">נקודת מפגש: </span>{e.meeting_point}</span></li>}
  {!brief && e.route && <li><Icon name="route" size={18} /><span><span class="visually-hidden">מסלול: </span>{e.route}</span></li>}
  {!brief && level && <li><Icon name="gauge" size={18} /><span><span class="visually-hidden">רמה: </span>{level}</span></li>}
  {!brief && e.instructor && <li><Icon name="wrench" size={18} /><span><span class="visually-hidden">מנחה: </span>{e.instructor}</span></li>}
  {!brief && e.is_upcoming && e.price && <li><Icon name="ticket" size={18} /><span><span class="visually-hidden">מחיר: </span>{e.price}</span></li>}
  {e.is_upcoming && e.spots_left != null && <li class="spots"><Icon name="users" size={18} /><span>{UI.spotsLeft(e.spots_left)}</span></li>}
  {!e.is_upcoming && e.participants_count != null && <li class="spots"><Icon name="users" size={18} /><span>{UI.participants(e.participants_count)}</span></li>}
</ul>

<style>
  .details { display: flex; flex-direction: column; gap: 10px; font-size: var(--fs-small); color: var(--slate); line-height: 1.45; }
  li { display: flex; gap: 10px; align-items: flex-start; }
  li :global(svg) { flex: none; color: var(--purple); margin-top: 1px; }
  .soft { color: var(--muted); }
  .spots { color: var(--green-700); font-weight: 700; }
  .spots :global(svg) { color: var(--green-700); }
</style>
