---
/** Compact card for a past event: image, title, date, participants, gallery link. */
import Icon from '../Icon.astro';
import type { CmsEvent } from '../../lib/cms';
import { assetUrl, withBase } from '../../lib/cms';
import { EVENT_TYPE, UI, formatDate } from '../../lib/labels';

interface Props { event: CmsEvent; headingLevel?: 'h2' | 'h3' }
const { event: e, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const href = withBase(`/events/${e.slug}/`);
---
<article class="card past">
  <a href={href} class="thumb" tabindex="-1" aria-hidden="true">
    {e.image && <img src={assetUrl(e.image, { width: 600 })} alt="" width="480" height="320" loading="lazy" />}
  </a>
  <div class="body">
    <span class="tag-text">{EVENT_TYPE[e.type]}</span>
    <H class="title"><a href={href}>{e.title}</a></H>
    <p class="meta">
      <span><Icon name="calendar" size={15} /><time datetime={e.start.slice(0, 10)}>{formatDate(e.start)}</time></span>
      {e.participants_count != null && <span class="ppl"><Icon name="users" size={15} />{UI.participants(e.participants_count)}</span>}
    </p>
    {e.gallery_url && (
      <a href={e.gallery_url} target="_blank" rel="noopener" class="link-arrow gal">{UI.toGallery}<span class="visually-hidden">: {e.title} (נפתח בחלון חדש)</span></a>
    )}
  </div>
</article>

<style>
  .past { display: flex; flex-direction: column; height: 100%; transition: box-shadow .25s ease, transform .25s ease; }
  .past:hover { box-shadow: var(--shadow-lift); transform: translateY(-3px); }
  .thumb { display: block; aspect-ratio: 3 / 2; background: var(--purple-100); overflow: hidden; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .past:hover .thumb img { transform: scale(1.04); }
  .body { flex: 1; display: flex; flex-direction: column; gap: 8px; padding: 18px 20px 12px; }
  .title { font-size: 1.125rem; line-height: 1.3; letter-spacing: -0.01em; }
  .title a { color: inherit; text-decoration: none; }
  .title a:hover { color: var(--purple); }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 0.8125rem; color: var(--muted); }
  .meta > span { display: inline-flex; align-items: center; gap: 6px; }
  .ppl { color: var(--green-700); font-weight: 700; }
  .gal { margin-top: auto; }
  @media (prefers-reduced-motion: reduce) { .past:hover, .past:hover .thumb img { transform: none; } }

  /* Phones: thumbnail beside text, like the homepage update rows */
  @media (max-width: 560px) {
    .past { flex-direction: row; align-items: stretch; gap: 14px; padding: 12px; }
    .thumb { flex: none; width: 104px; aspect-ratio: auto; min-height: 104px; border-radius: var(--r-xs); }
    .body { padding: 2px 0 0; gap: 4px; min-width: 0; }
    .title { font-size: 1.0625rem; }
    .gal { margin-top: 0; }
  }
</style>
