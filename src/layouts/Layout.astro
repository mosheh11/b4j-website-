---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyWhatsApp from '../components/StickyWhatsApp.astro';
import { getSiteSettings, withBase, USING_MOCK } from '../lib/cms';
import { UI } from '../lib/labels';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Header sits on the stone ground (true) or on white (false). */
  stoneHeader?: boolean;
}
const { title, description, image, stoneHeader = true } = Astro.props;
const site = await getSiteSettings();
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.short_name}`;
const desc = description ?? site.tagline;
const ogImage = new URL(image ?? withBase('/images/hero-ride.webp'), Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Event detail pages have their own registration CTA — the sticky WhatsApp bar would cover it.
const showStickyCta = !/\/events\/[^/]+\/?$/.test(Astro.url.pathname);
---
<!doctype html>
<html lang="he" dir="rtl" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="theme-color" content="#F5F0E8" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="text/calendar" title="יומן האירועים" href={withBase('/calendar.ics')} />
    {USING_MOCK && <meta name="x-content-source" content="mock" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&family=Heebo:wght@400;500;700&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.replace('no-js','js')</script>
    <slot name="head" />
  </head>
  <body class:list={[{ 'has-sticky-cta': showStickyCta }]}>
    <a class="skip-link" href="#main">{UI.skipToContent}</a>
    <Header stone={stoneHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {showStickyCta && <StickyWhatsApp />}
    <script>
      // Reveal-on-scroll for elements marked .reveal
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -10% 0px' });
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add('is-in'));
    </script>
  </body>
</html>
