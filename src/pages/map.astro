---
import Layout from '../layouts/Layout.astro';
import PageBanner from '../components/PageBanner.astro';
import Icon from '../components/Icon.astro';
import MunicipalityMap from '../components/map/MunicipalityMap.astro';
import { getPage, getWhatsappGroups, withBase } from '../lib/cms';
import type { CmsImage } from '../lib/cms';

interface MapPage {
  banner_title: string; banner_text?: string;
  static_map_image?: CmsImage | null; municipality_map_url?: string;
}
const [page, groups] = await Promise.all([getPage<MapPage>('map'), getWhatsappGroups()]);
const routeGroup = groups.find((g) => g.name.includes('עדכוני מסלול')) ?? groups[0];

const helpers = [
  {
    icon: 'flag', tone: 'purple', title: 'דיווח על מפגע בשביל',
    text: 'בור, חסימה או שלט חסר? קראו את העדכונים האחרונים ושתפו אותנו במה שראיתם.',
    href: withBase('/updates/?category=updates'), label: 'לעדכונים', external: false,
  },
  {
    icon: 'users', tone: 'stone', title: 'רכיבות קבוצתיות',
    text: 'רוצים להכיר את השבילים בחברה טובה? מצטרפים לאחת הרכיבות הקרובות.',
    href: withBase('/events/'), label: 'לרכיבות הקרובות', external: false,
  },
  ...(routeGroup ? [{
    icon: 'whatsapp', tone: 'green', title: routeGroup.name,
    text: routeGroup.description ?? '',
    href: routeGroup.invite_url, label: 'הצטרפות לקבוצה', external: true,
  }] : []),
] as const;
---
<Layout title={page.banner_title} description={page.banner_text}>
  <PageBanner title={page.banner_title} text={page.banner_text} />

  {page.municipality_map_url && (
    <section class="container map-wrap" aria-label="מפת שבילי האופניים">
      <MunicipalityMap url={page.municipality_map_url} image={page.static_map_image} title={`${page.banner_title} – המפה של עיריית ירושלים`} />
      <p class="note">
        <Icon name="layers" size={20} />
        <span>המפה מתוחזקת על ידי עיריית ירושלים. השכבות והסינונים שמופיעים בה – כמו שבילים קיימים ומתוכננים – נקבעים על ידי העירייה ועשויים להשתנות.</span>
      </p>
    </section>
  )}

  <section class="container section" aria-labelledby="helpers-title">
    <div class="section-head">
      <h2 id="helpers-title" class="h2">יוצאים לשביל</h2>
    </div>
    <ul role="list" class="helpers">
      {helpers.map((h) => (
        <li class:list={['helper card lift', h.tone]}>
          <span class="h-icon" aria-hidden="true"><Icon name={h.icon} size={24} /></span>
          <h3 class="h-title">{h.title}</h3>
          {h.text && <p class="h-text">{h.text}</p>}
          <a href={h.href} class="link-arrow h-link" {...(h.external ? { target: '_blank', rel: 'noopener' } : {})}>{h.label}</a>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .map-wrap { margin-top: clamp(-64px, -5vw, -32px); position: relative; }
  .note {
    display: flex; align-items: flex-start; gap: 10px; margin-top: 18px; padding-inline: 4px;
    font-size: var(--fs-small); line-height: 1.6; color: var(--muted); max-width: 72ch;
  }
  .note :global(svg) { flex: none; margin-top: 2px; color: var(--green); }

  .helpers { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 16px; }
  .helper { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; padding: clamp(22px, 3vw, 32px); }
  .helper.purple { background: var(--lilac); border-color: var(--lilac-line); }
  .helper.stone { background: var(--stone); border-color: var(--sand-2); }
  .helper.green { background: var(--green-50); border-color: #CFE8DF; }
  .h-icon {
    display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%;
    background: var(--white); color: var(--purple); margin-bottom: 4px;
  }
  .green .h-icon { color: var(--green-700); }
  .stone .h-icon { color: var(--ink); }
  .h-title { font-size: 1.3125rem; line-height: 1.3; letter-spacing: -0.015em; }
  .h-text { color: var(--slate); line-height: 1.65; flex: 1; }
  .h-link { margin-top: 4px; font-weight: 700; }
  .green .h-link { color: var(--green-700); }
  /* Whole card is tappable; the real link stays the link. */
  .h-link::before { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .h-link:focus-visible { outline: none; }
  .helper:has(.h-link:focus-visible) { outline: 3px solid var(--purple); outline-offset: 3px; }
</style>
