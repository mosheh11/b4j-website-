---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/cms';
---
<Layout title="הדף לא נמצא">
  <section class="nf">
    <div class="container inner">
      <div class="copy rise">
        <span class="eyebrow">שגיאה 404</span>
        <h1 class="display">נראה שירדנו<br /><span class="accent">מהשביל</span></h1>
        <p class="lead">הדף שחיפשתם לא נמצא – אולי הוא הועבר, ואולי הקישור שבור. הנה כמה דרכים לחזור לרכיבה:</p>
        <div class="cluster actions" style="--cluster:12px">
          <a href={withBase('/')} class="btn btn-primary btn-lg">לדף הבית<Icon name="arrow" size={18} stroke={2.2} /></a>
          <a href={withBase('/events/')} class="btn btn-white btn-lg"><Icon name="calendar" size={18} />אירועים ורכיבות</a>
          <a href={withBase('/updates/')} class="btn btn-white btn-lg"><Icon name="flag" size={18} />עדכונים מהשביל</a>
        </div>
      </div>

      <div class="art rise-2" aria-hidden="true">
        <svg viewBox="0 0 480 400" class="scene">
          <path class="route" d="M20 330 C 120 330, 120 220, 220 230 S 360 300, 400 200 S 440 90, 470 70" />
          <path class="route-off" d="M400 200 C 430 230, 455 260, 470 300" />
          <circle cx="20" cy="330" r="12" class="pin-start" />
          <g class="pin-lost" transform="translate(470 300)">
            <circle r="26" />
            <text y="9" text-anchor="middle">?</text>
          </g>
        </svg>
        <span class="num">404</span>
        <span class="bike"><Icon name="bike" size={56} stroke={1.5} /></span>
      </div>
    </div>
  </section>
</Layout>

<style>
  .nf { background: var(--stone); overflow: hidden; padding-bottom: var(--section-gap); }
  .inner { display: flex; flex-wrap: wrap; align-items: center; gap: 40px 56px; padding-top: clamp(24px, 5vw, 72px); }
  .copy { flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .actions { margin-top: 12px; }

  .art { flex: 1 1 420px; min-width: 0; position: relative; aspect-ratio: 6 / 5; max-width: 560px; margin-inline: auto; }
  .scene { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .route { fill: none; stroke: var(--green); stroke-width: 10; stroke-linecap: round; stroke-dasharray: 2 22; }
  .route-off { fill: none; stroke: var(--purple); stroke-width: 4; stroke-linecap: round; stroke-dasharray: 8 12; opacity: .55; }
  .pin-start { fill: var(--green); }
  .pin-lost circle { fill: var(--purple); }
  .pin-lost text { fill: var(--white); font: 700 26px var(--font); }
  .num {
    position: absolute; inset-inline-end: 2%; top: 0;
    font-size: clamp(6rem, 4rem + 9vw, 11rem); font-weight: 700; line-height: 1; letter-spacing: -0.05em;
    color: var(--lilac-line); opacity: .7;
  }
  .bike {
    position: absolute; inset-inline-start: 38%; top: 47%; width: 104px; height: 104px; border-radius: 50%;
    display: grid; place-items: center; background: var(--white); color: var(--purple);
    box-shadow: var(--shadow-card); animation: bob 3.2s ease-in-out infinite;
  }
  @keyframes bob { 50% { transform: translateY(-8px) rotate(-3deg); } }

  @media (max-width: 760px) {
    .actions .btn { flex: 1 1 100%; }
    .art { order: -1; flex-basis: 100%; max-width: 320px; margin-bottom: -16px; }
    .bike { width: 80px; height: 80px; }
    .bike :global(svg) { width: 42px; height: 42px; }
  }
  @media (prefers-reduced-motion: reduce) { .bike { animation: none; } }
</style>
