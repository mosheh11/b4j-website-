---
import Layout from '../layouts/Layout.astro';
import PageBanner from '../components/PageBanner.astro';
import SocialFeed from '../components/SocialFeed.astro';
import Icon from '../components/Icon.astro';
import RulesAccordion from '../components/join/RulesAccordion.astro';
import { getPage, getGroupsSplit, withBase } from '../lib/cms';
import type { CmsImage } from '../lib/cms';
import { UI } from '../lib/labels';
import { qrSvg } from '../lib/qr';

interface JoinPage {
  banner_title: string; banner_text?: string; banner_image?: CmsImage | null;
  community_cta_text?: string; group_rules?: string;
}
const [page, { community, topics }] = await Promise.all([getPage<JoinPage>('join'), getGroupsSplit()]);
const communityQr = community ? await qrSvg(community.invite_url) : '';
---
<Layout title={UI.joinActivity} description={page.banner_text}>
  <div class="join-top">
  <PageBanner title={page.banner_title} text={page.banner_text} image={page.banner_image} />
  </div>

  <!-- GENERAL COMMUNITY GROUP — the hero action of the page -->
  {community && (
    <section class="container community-wrap" aria-labelledby="community-title">
      <div class="community">
        <svg class="rings" viewBox="0 0 400 400" aria-hidden="true">
          <circle cx="200" cy="200" r="180" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="4 12" />
          <circle cx="200" cy="200" r="130" fill="none" stroke="currentColor" stroke-width="2" />
          <circle cx="200" cy="200" r="80" fill="none" stroke="currentColor" stroke-width="2" />
        </svg>
        <div class="community-copy">
          <span class="badge"><Icon name="sparkle" size={16} stroke={2.2} />מומלץ לכל מי שחדש</span>
          <h2 id="community-title" class="community-title">{community.name}</h2>
          {(page.community_cta_text || community.description) && (
            <p class="community-text">{page.community_cta_text || community.description}</p>
          )}
          <a href={community.invite_url} target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg community-btn">
            <Icon name="whatsapp" size={24} />הצטרפות לקבוצה הכללית
          </a>
        </div>
        <figure class="qr">
          <div class="qr-img" role="img" aria-label="קוד QR להצטרפות לקבוצה הכללית בוואטסאפ" set:html={communityQr} />
          <figcaption>או סרקו מהטלפון</figcaption>
        </figure>
      </div>
    </section>
  )}

  <!-- TOPIC GROUPS -->
  {topics.length > 0 && (
    <section id="groups" class="container section" aria-labelledby="groups-title">
      <div class="section-head">
        <h2 id="groups-title" class="h2">קבוצות לפי נושא</h2>
      </div>
      <ul role="list" class="groups">
        {topics.map((g) => (
          <li class="group card lift">
            <span class="g-icon" aria-hidden="true"><Icon name="whatsapp" size={22} /></span>
            <div class="g-copy">
              <h3 class="g-name">{g.name}</h3>
              {g.description && <p class="g-desc">{g.description}</p>}
            </div>
            <a href={g.invite_url} target="_blank" rel="noopener" class="btn btn-sm g-btn" aria-label={`${UI.joinGroup} לקבוצה ${g.name}`}>
              {UI.joinGroup}<Icon name="arrow" size={16} stroke={2.2} />
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- RULES -->
  {page.group_rules && (
    <section class="container section rules-section" aria-labelledby="rules-title">
      <div class="rules-head">
        <span class="eyebrow">לפני שמצטרפים</span>
        <h2 id="rules-title" class="h2">כללי הקבוצות</h2>
        <p class="lead">כמה כללים פשוטים ששומרים על הקבוצות נעימות, שימושיות ובנושא.</p>
      </div>
      <div class="rules-list"><RulesAccordion html={page.group_rules} /></div>
    </section>
  )}

  <!-- SOCIAL -->
  <section class="container section" aria-labelledby="social-title">
    <div class="section-head">
      <h2 id="social-title" class="h2">הפיד החברתי שלנו</h2>
      <p class="lead">לא בוואטסאפ? אפשר לעקוב אחרינו גם ברשתות.</p>
    </div>
    <SocialFeed />
  </section>
</Layout>

<style>
  /* ---------- Community group card ---------- */
  .community-wrap { margin-top: clamp(-64px, -5vw, -32px); position: relative; }
  .community {
    position: relative; overflow: hidden; isolation: isolate;
    background: var(--green-50); border: 1px solid #CFE8DF; border-radius: var(--r-xl);
    box-shadow: var(--shadow-card);
    padding: clamp(28px, 5vw, 60px) clamp(22px, 5vw, 64px);
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 32px 48px;
  }
  .rings { position: absolute; inset-inline-end: -90px; bottom: -120px; width: 440px; height: 440px; color: var(--green); opacity: .22; z-index: -1; }
  .community-copy { flex: 1 1 480px; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .badge {
    display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px; border-radius: var(--r-pill);
    background: var(--green-700); color: var(--white); font-size: var(--fs-label); font-weight: 700; line-height: 1.3;
  }
  .community-title { font-size: clamp(1.875rem, 1.4rem + 2vw, 3rem); line-height: 1.1; letter-spacing: -0.03em; max-width: 18ch; }
  .community-text { font-size: var(--fs-lead); line-height: 1.7; color: var(--slate); max-width: 34em; }
  .community-btn { margin-top: 8px; min-height: 64px; padding: 0 36px; font-size: 1.125rem; }
  .qr { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .qr-img { width: 168px; height: 168px; box-sizing: border-box; background: var(--white); border-radius: 20px; padding: 12px; box-shadow: 0 12px 30px rgba(31, 122, 95, 0.16); }
  .qr-img :global(svg) { width: 100%; height: 100%; display: block; }
  .qr figcaption { font-size: var(--fs-small); font-weight: 700; color: var(--muted); }

  /* ---------- Topic groups ---------- */
  .groups { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 16px; }
  .group {
    position: relative; display: grid; grid-template-columns: auto 1fr; grid-template-rows: 1fr auto;
    gap: 14px 16px; padding: 24px; border-radius: var(--r-md);
  }
  .group:hover { border-color: var(--lilac-line); }
  .group:focus-within { border-color: var(--purple); }
  .g-icon {
    grid-row: 1 / span 2; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%;
    background: var(--green-50); color: var(--green-700);
  }
  .g-copy { min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .g-name { font-size: 1.1875rem; line-height: 1.3; letter-spacing: -0.01em; }
  .g-desc { font-size: var(--fs-small); line-height: 1.6; color: var(--muted); }
  .g-btn {
    justify-self: start; --btn-bg: var(--white); --btn-fg: var(--green-700); border-color: #BFE0D4;
    transition: background-color .2s, color .2s, border-color .2s;
  }
  .g-btn:focus-visible { outline-offset: 3px; }
  /* Whole card is tappable; the real link stays the button. */
  .g-btn::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .group:hover .g-btn { --btn-bg: var(--green-700); --btn-fg: var(--white); border-color: var(--green-700); }
  .g-btn:hover { transform: none; }

  /* ---------- Rules ---------- */
  .rules-section { display: flex; flex-wrap: wrap; gap: 28px 64px; align-items: flex-start; }
  .rules-head { flex: 1 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 14px; position: sticky; top: calc(var(--header-h) + 24px); }
  .rules-list { flex: 1.6 1 520px; min-width: 0; }

  /* ---------- Mobile ---------- */
  @media (max-width: 760px) {
    .community { border-radius: var(--r-lg); }
    .community-btn { align-self: stretch; padding: 0 20px; }
    .qr { display: none; } /* on a phone you tap, you don't scan */
    /* Phones: the community CTA is the point of the page — keep it near the top. */
    .join-top :global(.page-banner .art) { display: none; }
    .rings { width: 300px; height: 300px; inset-inline-end: -110px; bottom: auto; top: -110px; }

    .group { grid-template-columns: 1fr auto; grid-template-rows: auto; padding: 18px; padding-inline-end: 14px; gap: 12px; align-items: center; }
    .g-icon { display: none; }
    .g-name { font-size: 1.0625rem; }
    .g-btn { padding: 0 18px; }
    .g-btn :global(svg) { display: none; }

    .rules-head { position: static; }
  }
</style>
