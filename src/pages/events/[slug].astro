---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import EventMeta from '../../components/EventMeta.astro';
import Countdown from '../../components/Countdown.astro';
import EventActions from '../../components/events/EventActions.astro';
import EventDetails from '../../components/events/EventDetails.astro';
import EventCard from '../../components/events/EventCard.astro';
import PastEventCard from '../../components/events/PastEventCard.astro';
import { getEvents, assetUrl, withBase, type CmsEvent } from '../../lib/cms';
import { EVENT_TYPE, UI } from '../../lib/labels';

export async function getStaticPaths() {
  const events = await getEvents();
  return events.map((event) => ({ params: { slug: event.slug }, props: { event, events } }));
}
interface Props { event: CmsEvent; events: CmsEvent[] }
const { event: e, events } = Astro.props;

const upcomingOthers = events.filter((x) => x.is_upcoming && x.slug !== e.slug);
const more = upcomingOthers.length
  ? upcomingOthers.slice(0, 3)
  : events.filter((x) => x.slug !== e.slug).reverse().slice(0, 3);
const moreAreUpcoming = upcomingOthers.length > 0;
const tagClass = e.type === 'workshop' ? 'tag tag-green' : e.type === 'other' ? 'tag tag-soft' : 'tag';
const ogImage = e.image ? assetUrl(e.image, { width: 1200 }) : undefined;
const hasBody = !!e.body?.trim();
/** A route written as "A ← B ← C" renders as stops; anything else as text. */
const stops = (e.route ?? '').split('←').map((s) => s.trim()).filter(Boolean);
---
<Layout title={e.title} description={e.summary} image={ogImage}>
  <section class="hero">
    <div class="container">
      <nav aria-label="פירורי לחם" class="crumbs">
        <a href={withBase(e.is_upcoming ? '/events/' : '/events/#past')} class="back">
          <Icon name="arrowRight" size={18} />{e.is_upcoming ? UI.allEvents : 'לאירועים שהיו'}
        </a>
      </nav>
      <div class="hero-inner">
        <div class="copy rise">
          <div class="tags">
            <span class={tagClass}>{EVENT_TYPE[e.type]}</span>
            {!e.is_upcoming && <span class="tag tag-past">האירוע הסתיים</span>}
          </div>
          <h1 class="h1 title">{e.title}</h1>
          {e.summary && <p class="lead">{e.summary}</p>}
          <EventMeta event={e} full={e.is_upcoming} />
          {!e.is_upcoming && e.participants_count != null && (
            <p class="ppl"><Icon name="users" size={20} />{UI.participants(e.participants_count)}</p>
          )}
          <div class="hero-actions"><EventActions event={e} size="lg" /></div>
        </div>
        {e.image && (
          <figure class="art rise-2">
            <img src={assetUrl(e.image, { width: 1400 })} alt={e.image.description ?? ''} width="1200" height="840" fetchpriority="high" />
            <span class="dot" aria-hidden="true"></span>
          </figure>
        )}
      </div>
    </div>
  </section>

  <section class="container section content">
    <div class="main">
      {hasBody && (
        <div class="block about">
          <h2 class="h3 sub">על האירוע</h2>
          <div class="prose" set:html={e.body} />
        </div>
      )}
      {e.route && (
        <div class="block route">
          <h2 class="h3 sub"><Icon name="route" size={24} />המסלול</h2>
          {stops.length > 1 ? (
            <ol role="list" class="stops">{stops.map((s) => <li>{s}</li>)}</ol>
          ) : (
            <p class="meet-place">{e.route}</p>
          )}
        </div>
      )}
      {e.meeting_point && (
        <div class="block meet">
          <h2 class="h3 sub"><Icon name="pin" size={24} />נקודת המפגש</h2>
          <p class="meet-place">{e.meeting_point}</p>
          <a class="link-arrow" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${e.meeting_point}, ירושלים`)}`} target="_blank" rel="noopener">פתיחה במפות</a>
        </div>
      )}
    </div>
    <aside class="side" aria-label="פרטי האירוע">
      <div class="side-card">
        <h2 class="side-title">{e.is_upcoming ? 'פרטים והרשמה' : 'פרטי האירוע'}</h2>
        <EventDetails event={e} />
        {e.is_upcoming && <Countdown start={e.start} class="cd" />}
        <EventActions event={e} stacked />
      </div>
    </aside>
  </section>

  {more.length > 0 && (
    <section class="container section" aria-labelledby="more-title">
      <div class="section-head">
        <h2 id="more-title" class="h2">{moreAreUpcoming ? 'עוד אירועים קרובים' : 'עוד אירועים'}</h2>
        <a href={withBase('/events/')} class="link-arrow">{UI.allEvents}</a>
      </div>
      <ul role="list" class:list={['more', { compact: !moreAreUpcoming }]}>
        {more.map((x) => <li class="reveal">{moreAreUpcoming ? <EventCard event={x} compact /> : <PastEventCard event={x} />}</li>)}
      </ul>
    </section>
  )}
</Layout>

<style>
  /* ---------- Hero ---------- */
  .hero { background: var(--stone); padding: clamp(8px, 2vw, 24px) 0 clamp(56px, 7vw, 96px); overflow: hidden; }
  .crumbs { margin-bottom: clamp(8px, 2vw, 20px); }
  .back { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: var(--ink); font-weight: 500; text-decoration: none; }
  .back:hover { color: var(--purple); }
  .hero-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 40px 56px; }
  .copy { flex: 1 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 18px; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .tag-past { background: var(--sand-2); color: var(--ink); }
  .title { max-width: 18ch; }
  .copy .lead { margin: 0; }
  .ppl { display: inline-flex; align-items: center; gap: 10px; font-size: 1.25rem; font-weight: 700; color: var(--green-700); }
  .hero-actions { margin-top: 8px; }
  .art { flex: 1 1 400px; min-width: 0; margin: 0; position: relative; isolation: isolate; }
  .art img { width: 100%; aspect-ratio: 10 / 7; object-fit: cover; border-radius: var(--r-lg); background: var(--purple-100); }
  .dot {
    position: absolute; inset-inline-end: -24px; bottom: -28px; width: 112px; height: 112px; border-radius: 50%;
    background: var(--green); z-index: -1;
  }

  /* ---------- Content ---------- */
  .content { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 40px clamp(32px, 5vw, 72px); align-items: start; }
  .main { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .sub { display: flex; align-items: center; gap: 10px; }
  .sub :global(svg) { color: var(--purple); flex: none; }
  .block { display: flex; flex-direction: column; gap: 14px; }
  .block + .block { margin-top: 28px; padding-top: 28px; border-top: 1px solid var(--line); }
  .stops { display: flex; flex-direction: column; gap: 0; position: relative; }
  .stops li { position: relative; padding-inline-start: 34px; padding-block: 8px; font-size: 1.0625rem; color: var(--ink); font-weight: 500; }
  .stops li::before {
    content: ''; position: absolute; inset-inline-start: 6px; top: 50%; translate: 0 -50%; width: 14px; height: 14px;
    border-radius: 50%; background: var(--white); border: 3px solid var(--green); z-index: 1;
  }
  .stops li:first-child::before, .stops li:last-child::before { background: var(--green); }
  .stops li + li::after {
    content: ''; position: absolute; inset-inline-start: 12px; bottom: 50%; height: 100%; width: 2px;
    background: repeating-linear-gradient(to bottom, var(--green) 0 4px, transparent 4px 8px);
  }
  .meet-place { font-size: 1.125rem; color: var(--ink); font-weight: 500; }
  .meet .link-arrow { align-self: flex-start; }

  .side { position: sticky; top: calc(var(--header-h) + 16px); }
  .side-card {
    background: var(--white); border: 1px solid var(--line); border-radius: var(--r-lg); box-shadow: var(--shadow-card);
    padding: 28px 26px; display: flex; flex-direction: column; gap: 20px;
  }
  .side-title { font-size: 1.25rem; }
  .side :global(.cd) { display: flex; }
  .side :global(.cd .unit) { flex: 1; }

  /* ---------- More ---------- */
  .more { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 20px; }
  .more.compact { grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 16px; }
  .more > li { min-width: 0; }

  @media (max-width: 980px) {
    .content { grid-template-columns: 1fr; }
    .side { position: static; }
  }
  @media (max-width: 760px) {
    .hero-inner { gap: 32px; }
    .art { order: -1; flex-basis: 100%; }
    .art img { aspect-ratio: 4 / 3; }
    .dot { width: 72px; height: 72px; inset-inline-end: -8px; bottom: -18px; }
    .side-card { padding: 22px 18px; box-shadow: 0 12px 36px rgba(26, 20, 32, .08); }
  }
  @media (max-width: 560px) { .more.compact { gap: 12px; } }
</style>
